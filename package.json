{
  "name": "piagent",
  "version": "0.1.0",
  "description": "Centralized Agent Infrastructure Plane for the Pi Ecosystem: Ollama inference, priority scheduling, agent lifecycle, MCP bridging, and out-of-band preemption.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "chat": "tsx src/cli/chat.ts",
    "test": "tsx --test tests/**/*.test.ts"
  },
  "bin": {
    "piagent-chat": "bin/piagent-chat.mjs"
  },
  "files": [
    "dist",
    "bin"
  ],
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "fastify": "^5.2.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
